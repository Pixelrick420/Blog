<%- include('partials/header', { title: 'New Post' }) %>

<main class="page-form">
  <div class="form-header">
    <a href="/" class="back-link">← Back to Index</a>
    <h1 class="form-title reveal-line">New<br><span class="accent-line">Post<span class="dot">.</span></span></h1>
    <p class="form-sub reveal-fade delay-1">Say something worth reading.</p>
  </div>

  <% if (error) { %>
    <div class="form-error reveal-fade"><span>!</span> <%= error %></div>
  <% } %>

  <form action="/posts" method="POST" class="post-form reveal-fade delay-2">
    <div class="form-row">
      <div class="form-group form-group--wide">
        <label for="title" class="form-label">Title <span class="required">*</span></label>
        <input type="text" id="title" name="title" class="form-input" placeholder="Name your idea" required autocomplete="off" />
      </div>
      <div class="form-group">
        <label for="category" class="form-label">Category</label>
        <input type="text" id="category" name="category" class="form-input" placeholder="Type to search categories…" list="catList" autocomplete="off" />
        <datalist id="catList">
          <% categories.forEach(c => { %><option value="<%= c %>"><% }) %>
        </datalist>
      </div>
    </div>

    <div class="form-group">
      <label for="excerpt" class="form-label">Excerpt <span class="hint">(optional — auto-generated if blank)</span></label>
      <input type="text" id="excerpt" name="excerpt" class="form-input" placeholder="One sharp sentence that makes someone read on" autocomplete="off" />
    </div>

    <div class="form-group">
      <label for="body" class="form-label">Body <span class="required">*</span></label>
      <textarea id="body" name="body" style="display:none"></textarea>
      <div id="editor-container"></div>
      <div class="word-count-row">
        <span id="wordCount" class="word-count">0 words</span>
        <span id="readTimeEst" class="word-count">~ 0 min read</span>
      </div>
    </div>

    <div class="form-actions">
      <a href="/" class="btn-outline">Cancel</a>
      <button type="submit" class="btn-primary">Publish Post →</button>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
